# ============================================================
#  SmartSac — Cấu hình môi trường (.env.example)
#  Sao chép file này thành .env rồi điền giá trị thực.
# ============================================================

# AI Feature Flag
# Đặt "true" để bật tính năng AI Gemini, "false" để tạm tắt.
USE_AI=false

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Flask
SECRET_KEY=your_very_long_random_secret_key_here
DATABASE_URL=mysql+pymysql://root:your_root_password@mysql/your_dbname?charset=utf8mb4

# Email (dùng cho quên mật khẩu)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_email_password

# Redis (telemetry realtime)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cloudflare Turnstile CAPTCHA Flag
# Đặt "true" để bật CAPTCHA khi đăng nhập/đăng ký/quên mật khẩu, "false" để bỏ qua.
USE_CAPTCHA=true

# Lấy từ Cloudflare Dashboard → Turnstile → Add Site
CF_TURNSTILE_SITE_KEY=0x4AAAAAAA...        # public, dùng trong HTML
CF_TURNSTILE_SECRET_KEY=0x4AAAAAAA...     # private, chỉ dùng backend

# Cookie / Session isolation
# SESSION_COOKIE_SECURE: true khi production (HTTPS), false khi dev (HTTP)
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE: Lax (khuyến nghị), Strict, hoặc None
SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_PATH: giới hạn path nếu app chạy trên subpath, ví dụ /app
# Để trống hoặc / nếu app chạy ở root domain
SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN: để trống = dùng host hiện tại; điền subdomain nếu cần giới hạn
SESSION_COOKIE_DOMAIN=
